{
  "schema": 1,
  "id": "gutenberg",
  "name": "Gutenberg's Hoard",
  "purpose": "Local editorial publishing with incorporated layout engine, complete desktop editor, editable stories/pages and PDF export.",
  "capabilities": [
    "publication-catalog",
    "native-designcraft-documents",
    "native-designcraft-mcp-discovery",
    "native-designcraft-mcp-dispatch",
    "persistent-designcraft-sessions",
    "editorial-page-preview",
    "multipage-native-pdf",
    "multipage-raster-pdf",
    "hoard-source-references",
    "hub-work-profiles",
    "owned-editorial-engine",
    "owned-desktop-editor",
    "gutenberg-native-archives",
    "historical-document-import",
    "engine-mcp-discovery",
    "engine-mcp-dispatch"
  ],
  "placeholders": [
    "GUTENBERG_DIR",
    "PYTHON",
    "APP_URL",
    "TOKEN_FILE"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5218",
    "TOKEN_FILE": "{GUTENBERG_DIR}/data/mcp-token",
    "PYTHON": "{GUTENBERG_DIR}/.venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "{APP_URL}",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "gutenbergs-hoard"
      }
    },
    "identify": {
      "service": [
        "gutenbergs-hoard"
      ],
      "title": [
        "gutenberg's hoard",
        "gutenberg"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": [
        "-m",
        "gutenberg_hoard"
      ],
      "cwd": "{GUTENBERG_DIR}",
      "env": {
        "GUTENBERG_HOST": "127.0.0.1",
        "GUTENBERG_PORT": "5218",
        "GUTENBERG_PORT_STRICT": "1",
        "GUTENBERG_DATA_DIR": "{GUTENBERG_DIR}/data"
      },
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 25
      }
    }
  },
  "x-family": {
    "agent_contract": true,
    "stack": "python",
    "copilot": true
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-m",
      "gutenberg_hoard.mcp_server"
    ],
    "cwd": "{GUTENBERG_DIR}",
    "env": {
      "GUTENBERG_DATA_DIR": "{GUTENBERG_DIR}/data",
      "HOARD_APP_ID": "gutenberg",
      "HOARD_TOKEN_FILE": "{TOKEN_FILE}"
    },
    "optional_env": [
      "HOARD_HUB_URL"
    ]
  },
  "notes": "Owned source and build under native/. Libraries and HoardLink are installed in the dedicated environment; no external app CLI/GUI path is used. Native and raster PDFs retain prior contracts and expose warnings/text checks. Historical names, originals, linked assets, publication IDs and snapshots remain supported. No PDF/X or PDF/UA certification claim."
}
